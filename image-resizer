    <script>
        document.getElementById('year').innerText = new Date().getFullYear();
        const imageInput = document.getElementById('imageInput');
        const infoArea = document.getElementById('infoArea');
        let selectedFile;

        imageInput.addEventListener('change', (e) => {
            selectedFile = e.target.files[0];
            if(selectedFile) {
                document.getElementById('fileName').innerText = selectedFile.name;
                document.getElementById('fileSize').innerText = (selectedFile.size / 1024).toFixed(2) + " KB";
                const reader = new FileReader();
                reader.onload = (event) => {
                    document.getElementById('previewThumb').style.backgroundImage = `url(${event.target.result})`;
                };
                reader.readAsDataURL(selectedFile);
                infoArea.classList.remove('hidden');
            }
        });

        document.getElementById('resizeBtn').onclick = async () => {
            const options = { maxSizeMB: 1, maxWidthOrHeight: 1920, useWebWorker: true, initialQuality: 0.85 };
            try {
                const btn = document.getElementById('resizeBtn');
                btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin mr-2"></i> Optimizing...`;
                btn.disabled = true;
                const compressedFile = await imageCompression(selectedFile, options);
                const reader = new FileReader();
                reader.readAsDataURL(compressedFile);
                reader.onloadend = () => {
                    localStorage.setItem('compressedImg', reader.result);
                    localStorage.setItem('oldSize', (selectedFile.size / 1024).toFixed(2));
                    localStorage.setItem('newSize', (compressedFile.size / 1024).toFixed(2));
                    localStorage.setItem('imgName', selectedFile.name);
                    location.assign("image-resizerdownload.html");
                };
            } catch (err) {
                alert('Optimization failed! Please try another image.');
                document.getElementById('resizeBtn').innerHTML = `<i class="fa-solid fa-wand-magic-sparkles mr-2"></i>Start Optimization`;
